{
    "name": "laravel/horizon",
    "description": "Dashboard and code-driven configuration for Laravel queues.",
    "keywords": ["laravel", "queue"],
    "license": "MIT",
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "inertiajs/inertia-laravel": "^2.0",
        "nesbot/carbon": "^2.17|^3.0",
        "ramsey/uuid": "^4.0",
        "symfony/console": "^6.0|^7.0",
        "symfony/error-handler": "^6.0|^7.0",
        "symfony/polyfill-php83": "^1.28",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^2.0",
        "predis/predis": "^1.1|^2.0|^3.0"
    },
    "suggest": {
        "ext-redis": "Required to use the Redis PHP driver.",
        "predis/predis": "Required when not using the Redis PHP driver (^1.1|^2.0|^3.0)."
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Horizon\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\Horizon\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.x-dev"
        },
        "laravel": {
            "providers": [
                "Laravel\\Horizon\\HorizonServiceProvider"
            ],
            "aliases": {
                "Horizon": "Laravel\\Horizon\\Horizon"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@prepare",
            "@setup"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "setup": [
            "npm ci",
            "npm run build"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@clear",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@clear",
            "@build",
            "npx concurrently -c \"#93c5fd,#fdba74\" \"php vendor/bin/testbench serve --ansi\" \"npm run watch\" --names=server,vite --kill-others"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse --verbose"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    }
}
