{
    "name": "laravel-horizon",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "dev": "vp dev",
        "format": "vp fmt resources/js scripts vite.config.ts",
        "format:check": "vp fmt --check resources/js scripts vite.config.ts",
        "lint": "vp lint resources/js scripts",
        "typecheck": "vp check --no-fmt --no-lint resources/js scripts vite.config.ts",
        "watch": "vp build --watch",
        "wayfinder:generate": "node scripts/generate-wayfinder.mjs --path=resources/js/generated --skip-actions"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@inertiajs/react": "^3.6.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.25.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "laravel-vite-plugin": "^3.1.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
        "vite-plus": "0.2.6"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
    },
    "engines": {
        "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
    }
}
